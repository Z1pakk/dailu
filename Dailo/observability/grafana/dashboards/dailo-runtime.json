{
  "title": "Dailo Runtime Health",
  "uid": "dailo-runtime",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "time": { "from": "now-1h", "to": "now" },
  "panels": [
    {
      "id": 1,
      "title": "Process memory (working set)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "fieldConfig": { "defaults": { "unit": "bytes" }, "overrides": [] },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "dotnet_process_memory_working_set_bytes",
          "legendFormat": "working set",
          "refId": "A"
        }
      ]
    },
    {
      "id": 2,
      "title": "GC heap size (last collection)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "fieldConfig": { "defaults": { "unit": "bytes" }, "overrides": [] },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "dotnet_gc_last_collection_heap_size_bytes",
          "legendFormat": "heap size",
          "refId": "A"
        }
      ]
    },
    {
      "id": 3,
      "title": "GC collections by generation",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "sum(rate(dotnet_gc_collections_total[5m])) by (gc_heap_generation)",
          "legendFormat": "{{gc_heap_generation}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 4,
      "title": "Thread pool queue length",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "dotnet_thread_pool_queue_length_total",
          "legendFormat": "queue length",
          "refId": "A"
        }
      ]
    }
  ]
}
