# Dev container tool versions, read by the Dockerfile at build time.
# The build may only read .devcontainer/ (Rider's "Clone Sources" builds from a copy of this folder), so versions that
# also live in the repo are repeated here. post-create.sh warns when they drift apart.
# Keep NODE_VERSION equal to Dailu/src/frontend/Dailu.ClientApp/.nvmrc (without the "v"); npm ships with Node.
NODE_VERSION=24.16.0
CLAUDE_CODE_VERSION=2.1.327
